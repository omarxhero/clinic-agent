# انسخ هذا الملف وسمّه  .env  ثم عبّي المفاتيح
# (Copy this file, rename to .env, paste your keys)

# ===== العقل (اختر واحد) =====

# 1) مجاني — Google Gemini
#    سجّل من: https://aistudio.google.com  >  Get API key
BRAIN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
BRAIN_MODEL=gemini-2.5-flash-lite
BRAIN_API_KEY=

# 2) رخيص مدفوع — DeepSeek (احذف # من الثلاث أسطر تحت وحمّل # من الخيار الأول)
# BRAIN_BASE_URL=https://api.deepseek.com/v1
# BRAIN_MODEL=deepseek-chat
# BRAIN_API_KEY=

# ===== فهم الفويس نوت (اختياري، مجاني) =====
# سجّل من: https://console.groq.com  >  API Keys
GROQ_API_KEY=
